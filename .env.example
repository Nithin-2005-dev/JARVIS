# Copy to .env for local use. For Compose, set a unique secret before starting:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_ENV=development
JARVIS_DATABASE_URL=sqlite:///data/events.sqlite
JARVIS_SECRET_KEY=
JARVIS_FRONTEND_ORIGINS=http://localhost:3000
JARVIS_LOG_LEVEL=INFO
JARVIS_AUTH_ENABLED=true
JARVIS_SESSION_TTL=3600
JARVIS_RATE_LIMIT=60
JARVIS_MAX_REQUEST_BYTES=1048576
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
JARVIS_DOMAIN=jarvis.example.com
